<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.irvr.attendance.controller.StudentController"
      spacing="15" style="-fx-background-color: #f5f5f5; -fx-padding: 20;">

    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
        <Label fx:id="welcomeLabel" text="Welcome, Student" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" 
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 20;"/>
    </HBox>

    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
        <Label text="Mark Attendance" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
        <Text text="Enter the session code from your lecturer's IRVR code" style="-fx-font-size: 12; -fx-fill: gray;"/>
        
        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Session Code:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="sessionCodeField" promptText="Enter session code"/>
            </VBox>
            <Button fx:id="markAttendanceButton" text="Mark Attendance" onAction="#handleMarkAttendance" 
                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-padding: 10 20;"/>
        </HBox>
        
        <Label fx:id="statusLabel" text="" style="-fx-font-size: 13;"/>
        
        <VBox spacing="5" style="-fx-padding: 10; -fx-background-color: #e8f4f8; -fx-background-radius: 5;">
            <Text text="📱 How to mark attendance:" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
            <Text text="1. Scan the IRVR code displayed by your lecturer" style="-fx-font-size: 11;"/>
            <Text text="2. Enter the session code shown in the QR code" style="-fx-font-size: 11;"/>
            <Text text="3. Click 'Mark Attendance' to submit" style="-fx-font-size: 11;"/>
            <Text text="Note: Codes expire after 5 minutes for security" style="-fx-font-size: 11; -fx-fill: #e74c3c;"/>
        </VBox>
    </VBox>

    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;" VBox.vgrow="ALWAYS">
        <Label text="My Attendance History" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
        <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="courseColumn" text="Course" prefWidth="350"/>
                <TableColumn fx:id="timeColumn" text="Time Marked" prefWidth="250"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
