<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.irvr.attendance.controller.LecturerController"
      spacing="15" style="-fx-background-color: #f5f5f5; -fx-padding: 20;">

    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
        <Label fx:id="welcomeLabel" text="Welcome, Lecturer" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" 
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 20;"/>
    </HBox>

    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
        <Label text="Session Control" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
        <Label fx:id="sessionStatusLabel" text="No active session" style="-fx-font-size: 14;"/>
        <Label fx:id="timerLabel" text="" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
        
        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Course Name:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="courseNameField" promptText="e.g., Computer Science 101"/>
            </VBox>
            <Button fx:id="startSessionButton" text="Start New Session" onAction="#handleStartSession" 
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 10 20;"/>
            <Button fx:id="stopSessionButton" text="Stop Session" onAction="#handleStopSession" visible="false"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 20;"/>
        </HBox>
        
        <VBox spacing="10" alignment="CENTER" visible="false" fx:id="qrCodeContainer">
            <Label text="IRVR Code - Display for Students to Scan" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            <ImageView fx:id="qrCodeImageView" fitWidth="300" fitHeight="300" preserveRatio="true"/>
            <Label text="Auto-refreshing code: Expires every 5 minutes and automatically generates a new one." 
                   style="-fx-font-size: 11; -fx-text-fill: gray;" wrapText="true" maxWidth="300"/>
        </VBox>
    </VBox>

    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;" VBox.vgrow="ALWAYS">
        <Label text="Attendance Records" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
        <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="studentColumn" text="Student" prefWidth="200"/>
                <TableColumn fx:id="courseColumn" text="Course" prefWidth="300"/>
                <TableColumn fx:id="timeColumn" text="Time Marked" prefWidth="200"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
