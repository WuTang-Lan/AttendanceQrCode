modules = ["java-graalvm22.3"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "JavaFX Attendance App"

[[workflows.workflow]]
name = "JavaFX Attendance App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mvn compile exec:java -Dexec.mainClass=\"com.example.attendance.LoginScreen\""

[workflows.workflow.metadata]
outputType = "vnc"
